{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "nodeVersion": "18.x",
  "env": [
    "EDGE_CONFIG_ID",
    "VERCEL_TOKEN",
    "VERCEL_TEAM_ID"
  ],
  "functions": {
    "pages/api/**": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/staff",
      "destination": "/staff/"
    }
  ]
}
